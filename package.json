{
  "name": "pi-agent-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of pi coding agent extensions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "https://github.com/5aaee9/pi-agent-extensions.git"
  },
  "workspaces": [
    "pi-provider-sub2api",
    "pi-custom-provider",
    "pi-continue",
    "pi-skill",
    "pi-model-trace",
    "pi-autocompact",
    "dsh-autocompact",
    "dsh-custom-provider-reasoning-efforts",
    "dsh-thread-summary"
  ],
  "type": "module",
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:scripts": "node --test \"scripts/release/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint --deny-warnings . && npm run lint:tooling",
    "lint:tooling": "oxlint --disable-nested-config -c .oxlintrc.tooling.json scripts .changeset",
    "lint:fix": "oxlint --fix . && oxlint --fix --disable-nested-config -c .oxlintrc.tooling.json scripts .changeset",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:scripts",
    "change": "changeset add",
    "change:status": "changeset status",
    "release:version": "changeset version",
    "release:gate": "node scripts/release/gate.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/parse": "^1.0.0",
    "@changesets/read": "^1.0.1",
    "@changesets/types": "^7.0.0",
    "@fission-ai/openspec": "1.14.3",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "pi": {
    "extensions": [
      "./pi-provider-sub2api/index.ts",
      "./pi-custom-provider/index.ts",
      "./pi-continue/index.ts",
      "./pi-skill/index.ts",
      "./pi-model-trace/index.ts",
      "./pi-autocompact/index.ts"
    ]
  }
}
