{
  "name": "@indexyz/pi-ask",
  "version": "0.0.0",
  "description": "Structured interactive questions for the Pi coding agent",
  "keywords": [
    "ask",
    "pi",
    "pi-package",
    "questions",
    "terminal-ui"
  ],
  "homepage": "https://github.com/5aaee9/pi-agent-extensions/tree/main/pi-ask#readme",
  "bugs": {
    "url": "https://github.com/5aaee9/pi-agent-extensions/issues"
  },
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5aaee9/pi-agent-extensions.git",
    "directory": "pi-ask"
  },
  "files": [
    "index.ts",
    "src/",
    "skills/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
