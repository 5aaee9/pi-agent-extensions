{
  "name": "pi-agent-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of pi coding agent extensions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "https://github.com/5aaee9/pi-agent-extensions.git"
  },
  "workspaces": [
    "pi-provider-sub2api",
    "pi-continue"
  ],
  "type": "module",
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "pack:sub2api": "npm pack --workspace @indexyz/pi-provider-sub2api --dry-run",
    "pack:continue": "npm pack --workspace @indexyz/pi-continue --dry-run"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "pi": {
    "extensions": [
      "./pi-provider-sub2api/index.ts",
      "./pi-continue/index.ts"
    ]
  }
}
