{
  "name": "@indexyz/pi-todo",
  "version": "0.0.0",
  "description": "A Pi todo tool and live task overlay with compact session persistence",
  "keywords": [
    "pi",
    "pi-package",
    "task-list",
    "todo"
  ],
  "homepage": "https://github.com/5aaee9/pi-agent-extensions/tree/main/pi-todo#readme",
  "bugs": {
    "url": "https://github.com/5aaee9/pi-agent-extensions/issues"
  },
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5aaee9/pi-agent-extensions.git",
    "directory": "pi-todo"
  },
  "files": [
    "config.ts",
    "index.ts",
    "locales/",
    "todo.ts",
    "todo-overlay.ts",
    "LICENSE",
    "docs/configuration.md",
    "docs/overlay.md",
    "docs/tool-schema.md",
    "README.md",
    "CHANGELOG.md",
    "state/invariants.ts",
    "state/i18n-bridge.ts",
    "state/replay.ts",
    "state/selectors.ts",
    "state/state-reducer.ts",
    "state/state.ts",
    "state/store.ts",
    "state/task-graph.ts",
    "tool/normalize-params.ts",
    "tool/response-envelope.ts",
    "tool/sanitize.ts",
    "tool/types.ts",
    "view/format.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@juicesharp/rpiv-i18n": "2.15.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@juicesharp/rpiv-i18n": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-i18n": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
