{
  "name": "@indexyz/dsh-custom-provider-reasoning-efforts",
  "version": "0.2.1",
  "description": "Declare reasoningEfforts and vision modalities for hand-written dsh provider routes the pi-ai catalog does not describe, and fill their discovered metadata",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-package",
    "llm",
    "pi-ai",
    "plugin",
    "reasoning",
    "vision"
  ],
  "homepage": "https://github.com/5aaee9/pi-agent-extensions/tree/main/dsh-custom-provider-reasoning-efforts#readme",
  "bugs": {
    "url": "https://github.com/5aaee9/pi-agent-extensions/issues"
  },
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5aaee9/pi-agent-extensions.git",
    "directory": "dsh-custom-provider-reasoning-efforts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:host",
    "build:host": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-config-editor": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "release": {
    "smoke": "test/smoke-release.ts"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
