{
  "name": "pi-agent-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of pi coding agent extensions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "5aaee9",
  "repository": {
    "type": "git",
    "url": "https://github.com/5aaee9/pi-agent-extensions.git"
  },
  "workspaces": [
    "pi-provider-sub2api",
    "pi-custom-provider",
    "pi-continue",
    "pi-skill",
    "pi-model-trace",
    "pi-autocompact"
  ],
  "type": "module",
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:scripts": "node --test \"scripts/release/test/*.test.mjs\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:scripts",
    "change": "changeset add",
    "change:status": "changeset status",
    "release:version": "changeset version",
    "release:gate": "node scripts/release/gate.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/parse": "^1.0.0",
    "@changesets/read": "^1.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "pi": {
    "extensions": [
      "./pi-provider-sub2api/index.ts",
      "./pi-custom-provider/index.ts",
      "./pi-continue/index.ts",
      "./pi-skill/index.ts",
      "./pi-model-trace/index.ts",
      "./pi-autocompact/index.ts"
    ]
  }
}
