{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["index.ts", "src/**/*.tsx", "test/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
